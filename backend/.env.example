# Copy to .env (never committed). On the server: ~/remal-src/backend/.env
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=remalperfumes.ly,www.remalperfumes.ly
SITE_URL=https://remalperfumes.ly

# database: SQLite, the file db.sqlite3 next to manage.py (kept out of git)
DB_ENGINE=sqlite

# uploaded photos and the dashboard's CSS/JS, served directly by Apache from the site's folder
MEDIA_ROOT=/home/remalper/public_html/media
STATIC_ROOT=/home/remalper/public_html/static

# mail: handed to the server's own mail system (localhost:25), no mailbox or password needed
DEFAULT_FROM_EMAIL=REMAL Website <contact@remalperfumes.ly>
CONTACT_TO=contact@remalperfumes.ly
