# Copy to .env (never committed). On the server: ~/remal-api/.env
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=api.remalperfumes.ly
# site origins allowed to call the API from the browser
CORS_ORIGINS=https://remalperfumes.ly,https://www.remalperfumes.ly
SITE_URL=https://remalperfumes.ly

# database: mysql on the server, sqlite locally
DB_ENGINE=mysql
DB_NAME=remalper_api
DB_USER=remalper_api
DB_PASSWORD=
DB_HOST=localhost

# uploaded images and collected static files, served directly by Apache from the subdomain's document root
MEDIA_ROOT=/home/remalper/api.remalperfumes.ly/media
STATIC_ROOT=/home/remalper/api.remalperfumes.ly/static

# mail (cPanel mailbox)
EMAIL_HOST=mail.remalperfumes.ly
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=no-reply@remalperfumes.ly
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=REMAL Website <no-reply@remalperfumes.ly>
CONTACT_TO=contact@remalperfumes.ly
